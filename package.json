{
  "name": "saju-mcp-dashboards",
  "version": "0.1.0",
  "description": "한국 전통 사주팔자 MCP 서버 + 웹 대시보드 (비상업적 오픈소스)",
  "main": "dist/index.js",
  "module": "./src/smithery.ts",
  "type": "module",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/server-http.js",
    "start:all": "yarn build && cd frontend && yarn build && cd .. && yarn start:http",
    "watch": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docs": "typedoc",
    "docs:serve": "npx http-server docs/api -p 8080",
    "benchmark": "tsx src/benchmark/index.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "fortune-telling",
    "saju",
    "korean-astrology",
    "fortune",
    "사주팔자",
    "운세",
    "명리학",
    "ai-assistant"
  ],
  "author": "VinylStage",
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VinylStage/saju-mcp-dashboards.git"
  },
  "bugs": {
    "url": "https://github.com/VinylStage/saju-mcp-dashboards/issues"
  },
  "homepage": "https://github.com/VinylStage/saju-mcp-dashboards#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@smithery/sdk": "^1.6.8",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.1.2",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.13",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/VinylStage"
  },
  "packageManager": "yarn@4.17.0",
  "workspaces": [
    "frontend"
  ]
}
